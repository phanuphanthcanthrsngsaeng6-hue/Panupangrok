#!/data/data/com.termux/files/usr/bin/python3
"""manus - CLI bridge to the Manus account agent (api.manus.ai/v2)

Usage:
  manus run "<task>"            create a task and print the result
  manus run "<task>" -p max     choose agent profile
  manus new  "<task>"           create task, print task id/url immediately (no wait)
  manus send <task_id> "<msg>"  continue an existing task
  manus get  <task_id>          inspect a task result
  manus files <task_id>         download task attachments into ./outputs/manus/<id>
  manus list                    list recent tasks
  manus credits                 show available credits
"""
from __future__ import annotations

import argparse
import json
import os
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

API_BASE = os.environ.get("MANUS_API_BASE", "https://api.manus.ai/v2")
ENV_FILE = Path(__file__).resolve().parent.parent / ".env"
POLL_INTERVAL = 3
TASK_TIMEOUT = int(os.environ.get("MANUS_TIMEOUT", "900"))


def api_key() -> str:
    key = os.environ.get("MANUS_API_KEY", "").strip()
    if key:
        return key
    if ENV_FILE.exists():
        for line in ENV_FILE.read_text().splitlines():
            line = line.strip()
            if line.startswith("MANUS_API_KEY="):
                return line.split("=", 1)[1].strip().strip('"').strip("'")
    sys.exit("ERROR: MANUS_API_KEY not set (env or project .env)")


def request(method: str, path: str, *, params=None, body=None, key=None):
    url = f"{API_BASE}/{path}"
    if params:
        from urllib.parse import urlencode
        url += "?" + urlencode(params)
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("x-manus-api-key", key or api_key())
    req.add_header("Accept", "application/json")
    if data:
        req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=45) as resp:
            return json.loads(resp.read().decode())
    except urllib.error.HTTPError as e:
        detail = e.read().decode(errors="replace")[:400]
        sys.exit(f"HTTP {e.code} on {path}: {detail}")
    except urllib.error.URLError as e:
        sys.exit(f"Network error on {path}: {e.reason}")


def is_done(status: str) -> bool:
    return status.lower() in {"stopped", "completed", "failed", "error", "waiting"}


def poll(task_id: str, task_url: str, key: str | None = None, quiet=False):
    started = time.time()
    last = ""
    while time.time() - started < TASK_TIMEOUT:
        data = request("GET", "task.detail", params={"task_id": task_id}, key=key)
        status = str(data.get("status") or "")
        if status != last and not quiet:
            print(f"  … status: {status}", file=sys.stderr)
            last = status
        if is_done(status):
            return data
        time.sleep(POLL_INTERVAL)
    return request("GET", "task.detail", params={"task_id": task_id}, key=key)


def extract_text(data: dict) -> str:
    parts = []
    for ev in data.get("messages") or []:
        a = ev.get("assistant_message") if isinstance(ev, dict) else None
        if isinstance(a, dict) and a.get("content"):
            parts.append(str(a["content"]))
    if not parts and data.get("content"):
        parts.append(str(data["content"]))
    return "\n\n".join(parts)


def collect_attachments(data: dict):
    out = []
    for ev in data.get("messages") or []:
        a = ev.get("assistant_message") if isinstance(ev, dict) else None
        if isinstance(a, dict):
            for att in a.get("attachments") or []:
                if isinstance(att, dict) and att.get("url"):
                    out.append(att)
    return out


def cmd_run(args):
    body = {
        "message": {"content": args.task},
        "title": args.title or "manus-cli task",
        "share_visibility": "private",
        "agent_profile": args.profile,
    }
    sent = request("POST", "task.create", body=body)
    tid = sent.get("task_id")
    turl = sent.get("task_url", "")
    print(f"task_id: {tid}")
    if turl:
        print(f"url: {turl}")
    data = poll(tid, turl, quiet=True)
    print("\n--- RESULT ---")
    print(extract_text(data) or "(no text content)")
    if args.show_files:
        for att in collect_attachments(data):
            print(f"[file] {att.get('filename') or att.get('name')}: {att['url']}")


def cmd_new(args):
    body = {
        "message": {"content": args.task},
        "title": args.title or "manus-cli task",
        "share_visibility": "private",
        "agent_profile": args.profile,
    }
    sent = request("POST", "task.create", body=body)
    print(json.dumps({"task_id": sent.get("task_id"), "task_url": sent.get("task_url")}, indent=2))


def cmd_send(args):
    request("POST", "task.sendMessage",
            body={"task_id": args.task_id, "message": {"content": args.message}})
    data = poll(args.task_id, "", quiet=True)
    print("\n--- RESULT ---")
    print(extract_text(data) or "(no text content)")


def cmd_get(args):
    data = request("GET", "task.detail", params={"task_id": args.task_id})
    print(f"status: {data.get('status')}")
    print(extract_text(data) or "(no text content)")


def cmd_files(args):
    data = request("GET", "task.listMessages",
                   params={"task_id": args.task_id, "order": "desc", "limit": 50})
    dest = Path(args.output_dir or f"outputs/manus/{args.task_id}").resolve()
    dest.mkdir(parents=True, exist_ok=True)
    saved = []
    for att in collect_attachments(data):
        url = att["url"]
        name = Path(url.split("?")[0]).name or f"file-{len(saved)}"
        try:
            with urllib.request.urlopen(url, timeout=90) as r:
                (dest / name).write_bytes(r.read())
            saved.append(name)
        except Exception as e:  # noqa: BLE001
            print(f"  ! failed {name}: {e}", file=sys.stderr)
    print(f"saved {len(saved)} file(s) -> {dest}")
    for n in saved:
        print(f"  {n}")


def cmd_list(args):
    data = request("GET", "task.list", params={"limit": args.limit})
    tasks = data.get("tasks") or data.get("data") or []
    if not tasks:
        print("(no tasks)")
        return
    for t in tasks:
        print(f"{t.get('task_id','?'):24} {str(t.get('status','?')):10} {t.get('title','')}")


def cmd_credits(args):
    print(json.dumps(request("GET", "usage.availableCredits"), indent=2))


def main():
    p = argparse.ArgumentParser(prog="manus", description="Bridge to Manus account agent")
    sub = p.add_subparsers(dest="cmd", required=True)

    def add_common(sp):
        sp.add_argument("-p", "--profile", default="standard",
                        choices=["standard", "lite", "max", "max-medium", "max-high",
                                 "max-extra", "max-ultra"])
        sp.add_argument("-t", "--title", default=None)

    r = sub.add_parser("run", help="create task and wait for result")
    r.add_argument("task")
    r.add_argument("--show-files", action="store_true")
    add_common(r)
    r.set_defaults(func=cmd_run)

    n = sub.add_parser("new", help="create task without waiting")
    n.add_argument("task")
    add_common(n)
    n.set_defaults(func=cmd_new)

    s = sub.add_parser("send", help="continue an existing task")
    s.add_argument("task_id")
    s.add_argument("message")
    s.set_defaults(func=cmd_send)

    g = sub.add_parser("get", help="inspect task result")
    g.add_argument("task_id")
    g.set_defaults(func=cmd_get)

    f = sub.add_parser("files", help="download attachments")
    f.add_argument("task_id")
    f.add_argument("-o", "--output-dir", default=None)
    f.set_defaults(func=cmd_files)

    l = sub.add_parser("list", help="list recent tasks")
    l.add_argument("--limit", type=int, default=10)
    l.set_defaults(func=cmd_list)

    c = sub.add_parser("credits", help="show credits")
    c.set_defaults(func=cmd_credits)

    args = p.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()

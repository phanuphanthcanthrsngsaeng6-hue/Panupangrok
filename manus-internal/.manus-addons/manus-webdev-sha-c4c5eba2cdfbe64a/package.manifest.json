{
  "schema_version": "0.1",
  "kind": "manus_addon_package",
  "distribution": "managed",
  "update_mode": "hot",
  "availability": {
    "session_kinds": [
      "main"
    ]
  },
  "host_permissions": [
    "addon.runtime.broker",
    "agent.run",
    "cloud_pc.read",
    "notification.send",
    "resource.access.check",
    "resource.project",
    "session.access.check",
    "session.task_mode.read",
    "webdev.analytics.read",
    "webdev.attachment.upload",
    "webdev.code.read",
    "webdev.connector_secret.import",
    "webdev.database.connection.read",
    "webdev.database.read",
    "webdev.database.write",
    "webdev.deploy",
    "webdev.env.propagate",
    "webdev.filesystem.read",
    "webdev.game_assets.read",
    "webdev.git.manage",
    "webdev.git.transport",
    "webdev.integration.context.read",
    "webdev.project.prepare",
    "webdev.project.read",
    "webdev.project.write",
    "webdev.runtime_env.read",
    "webdev.storage.read",
    "webdev.storage.write",
    "webdev.workspace.init"
  ],
  "browser_workers": {
    "checkpoint-preview": {
      "entry": "runtime/checkpoint-preview.html",
      "mode": "job"
    }
  },
  "device_mcp_access": "remote_enabled",
  "addon": {
    "id": "manus-webdev",
    "version": "0.0.88",
    "owner": "manus",
    "display_name": "Webdev",
    "description": "Managed web and mobile project knowledge, canonical webdev.init_project, project resources, lifecycle guidance and dashboard preview.",
    "backend_mode": "addon_server"
  },
  "addon_server": {
    "path": "server/run.mjs",
    "healthcheck_path": "/health",
    "auth_mode": "manus_session_context",
    "browser_credential": "subject_token",
    "managed_by": "addon_ci"
  },
  "credential": {
    "auth_method": "private_key_jwt"
  },
  "slots": {},
  "oauth": {
    "shopify": {
      "provider": "shopify",
      "reason": "Manage the products, inventory, discounts, and orders for the Shopify store selected by this Webdev project."
    }
  },
  "mcp_servers": {
    "webdev-mcp": {
      "description": "Use for developing any website, web page or web app (including single-page tools and interactive dashboards), mobile apps, and games with Manus-managed infrastructure. Hosting is optional; publishing is a separate step the user controls. Do not use if the user explicitly asks for a standalone HTML file, chart image, or script.",
      "model_routing": "webdev",
      "recovery_wait": {
        "queries": [
          "search",
          "list",
          "get"
        ],
        "timeout_ms": 60000
      },
      "device_targets": [
        "darwin-arm64",
        "darwin-amd64",
        "linux-amd64-gnu",
        "windows-amd64",
        "windows-arm64"
      ],
      "planning_tools": [
        "webdev.search_game_assets",
        "webdev.access_game_assets"
      ],
      "execution_mode": "runtime_mcp",
      "execution_modes": [
        "runtime_mcp",
        "device_mcp"
      ],
      "transport": "stdio",
      "command": "node",
      "args": [
        "runtime/mcp/server.mjs"
      ],
      "env": {
        "ADDON_SERVER_ENDPOINT": {
          "source": "addon_server.public_endpoint"
        }
      },
      "model_visible_tools": [
        "webdev.search_game_assets",
        "webdev.access_game_assets",
        "webdev.init_project",
        "webdev.attach_project",
        "webdev.take_screenshot",
        "webdev.request_secrets",
        "webdev.manus_git",
        "webdev.config",
        "webdev.shopify"
      ],
      "tool_call_timeout_ms": {
        "webdev.init_project": 1560000,
        "webdev.attach_project": 540000
      },
      "model_visible_tools_by_execution_mode": {
        "device_mcp": [
          "webdev.search_game_assets",
          "webdev.access_game_assets",
          "webdev.init_project",
          "webdev.attach_project",
          "webdev.request_secrets",
          "webdev.manus_git",
          "webdev.config",
          "webdev.shopify"
        ]
      },
      "result_effects": [
        "agent_mode",
        "agent_pause",
        "notification_wake",
        "model_preference"
      ],
      "tool_streaming": {
        "webdev.init_project": {
          "schema": "manus.addon.tool_streaming/v1",
          "preventAutoCollapse": true,
          "widget": {
            "uri": "manus-widget://manus-webdev/init-project-card/tool/init_project",
            "title": "Webdev project"
          },
          "state": {
            "initial": {
              "kind": "webdev_init_project"
            }
          },
          "presentation": {
            "brief": "Initializing project",
            "message_action": "Initializing project",
            "title_path": "title"
          }
        },
        "webdev.attach_project": {
          "schema": "manus.addon.tool_streaming/v1",
          "widget": {
            "uri": "manus-widget://manus-webdev/init-project-card/tool/attach_project",
            "title": "Webdev project"
          },
          "state": {
            "initial": {
              "kind": "webdev_attach_project"
            }
          },
          "presentation": {
            "brief": "Attaching project",
            "message_action": "Attaching project"
          }
        }
      },
      "host_callable_tools": [
        "webdev._resume_publish",
        "webdev._execute_operation",
        "webdev._resolve_local_preview",
        "webdev._resource_file_edit_completed",
        "webdev._eval_confirm_publish",
        "webdev._eval_confirm_blueprint",
        "webdev._eval_submit_secrets",
        "webdev._after_git_operation",
        "webdev._reconcile_runtime",
        "webdev._async_output",
        "webdev._run_start",
        "webdev._context_compaction",
        "webdev._context_snip"
      ],
      "tool_auth": {
        "webdev._resume_publish": {
          "type": "subject_token",
          "scopes": [
            "manus.addon.placement.device"
          ]
        },
        "webdev._execute_operation": {
          "type": "subject_token",
          "scopes": [
            "manus.addon.placement.device"
          ]
        },
        "webdev.search_game_assets": {
          "type": "subject_token",
          "scopes": [
            "manus.addon.placement.device"
          ]
        },
        "webdev.access_game_assets": {
          "type": "subject_token",
          "scopes": [
            "manus.addon.placement.device"
          ]
        },
        "webdev.init_project": {
          "type": "subject_token",
          "scopes": [
            "manus.addon.placement.device"
          ]
        },
        "webdev.attach_project": {
          "type": "subject_token",
          "scopes": [
            "manus.addon.placement.device"
          ]
        },
        "webdev.take_screenshot": {
          "type": "subject_token",
          "scopes": [
            "manus.addon.placement.device"
          ]
        },
        "webdev.request_secrets": {
          "type": "subject_token",
          "scopes": [
            "manus.addon.placement.device"
          ]
        },
        "webdev.manus_git": {
          "type": "subject_token",
          "scopes": [
            "manus.addon.placement.device"
          ]
        },
        "webdev.config": {
          "type": "subject_token",
          "scopes": [
            "manus.addon.placement.device"
          ]
        },
        "webdev.shopify": {
          "type": "subject_token"
        },
        "webdev._after_git_operation": {
          "type": "subject_token",
          "scopes": [
            "manus.addon.placement.device"
          ]
        },
        "webdev._reconcile_runtime": {
          "type": "subject_token",
          "scopes": [
            "manus.addon.placement.device"
          ]
        },
        "webdev._async_output": {
          "type": "subject_token",
          "scopes": [
            "manus.addon.placement.device"
          ]
        },
        "webdev._run_start": {
          "type": "subject_token",
          "scopes": [
            "manus.addon.placement.device"
          ]
        }
      }
    }
  },
  "device_artifacts": [
    {
      "target": {
        "os": "darwin",
        "arch": "arm64"
      },
      "path": "device/darwin-arm64.tar.gz"
    },
    {
      "target": {
        "os": "darwin",
        "arch": "amd64"
      },
      "path": "device/darwin-amd64.tar.gz"
    },
    {
      "target": {
        "os": "linux",
        "arch": "amd64",
        "libc": "gnu"
      },
      "path": "device/linux-amd64-gnu.tar.gz"
    },
    {
      "target": {
        "os": "windows",
        "arch": "amd64"
      },
      "path": "device/windows-amd64.tar.gz"
    },
    {
      "target": {
        "os": "windows",
        "arch": "arm64"
      },
      "path": "device/windows-arm64.tar.gz"
    }
  ],
  "tool_output_handlers": [
    {
      "mode": "async",
      "target": {
        "mcp_server": "manus-tools",
        "tool": "generate_image"
      },
      "handler": {
        "mcp_server": "webdev-mcp",
        "tool": "webdev._async_output"
      },
      "requires_project_output_paths": true
    }
  ],
  "replaces": {
    "tools": {
      "manus-tools": [
        "webdev_init_project",
        "webdev_take_screenshot",
        "webdev_check_status",
        "webdev_restart_server",
        "webdev_add_feature",
        "webdev_request_secrets",
        "webdev_deploy_project",
        "webdev_save_checkpoint",
        "webdev_rollback_checkpoint",
        "webdev_execute_sql",
        "webdev_debug"
      ]
    },
    "official_skills": [
      "webdev-custom-dockerfile",
      "webdev-data-api",
      "webdev-file-storage",
      "webdev-image-generation",
      "webdev-llm-integration",
      "webdev-manus-oauth",
      "webdev-maps-integration",
      "webdev-owner-notifications",
      "webdev-periodic-updates",
      "webdev-readme-fullstack",
      "webdev-readme-mobile",
      "webdev-readme-mobile-backend",
      "webdev-readme-static",
      "webdev-ssr-conversion",
      "webdev-voice-transcription",
      "trpc-react-ssr-conversion",
      "webdev-readme-game-bullet-hell",
      "webdev-readme-game-generic",
      "webdev-readme-game-platformer",
      "webdev-readme-game-rts",
      "webdev-readme-game-scribble-sky-hop",
      "webdev-readme-game-scroller",
      "webdev-readme-game-td",
      "webdev-readme-game-trading-card"
    ]
  },
  "runtime_capabilities": {
    "mcp_server": "webdev-mcp",
    "project": {
      "resolve_endpoint": "/api/v1/runtime/host-project"
    },
    "lsp": true,
    "preview": {
      "screenshot": true,
      "scripts": [
        {
          "src": "https://files.manuscdn.com/manus-web-dev-runtime/prod/runtime.js",
          "attributes": {
            "id": "manus-web-edit-runtime",
            "data-manus-channel-mode": "dual",
            "data-manus-host-dev": "true",
            "data-manus-not-found-container-selector": "#not-found-button-group"
          }
        }
      ],
      "managed_storage": {
        "mcp_server": "webdev-mcp",
        "tool": "webdev._async_output"
      }
    },
    "environment": {
      "config_endpoint": "/api/v1/runtime/host-environment",
      "allowed_keys": []
    },
    "workspace_mirror": {
      "driver": "s3",
      "config_endpoint": "/api/v1/runtime/workspace/mirror/credentials",
      "completed_endpoint": "/api/v1/runtime/workspace/mirror/completed"
    }
  },
  "agent_hooks": {
    "resource-file-edit-stream": {
      "execution_targets": [
        "device"
      ],
      "trigger": "host_file_edit_completed",
      "result_kinds": [
        "agent_reminder"
      ],
      "handler": {
        "mcp_server": "webdev-mcp",
        "tool": "webdev._resource_file_edit_completed"
      },
      "match": {
        "paths": [
          "*",
          "**/*"
        ]
      }
    },
    "git-checkpoint-tick": {
      "trigger": "host_terminal_post_exec",
      "handler": {
        "mcp_server": "webdev-mcp",
        "tool": "webdev._after_git_operation"
      },
      "match": {
        "command_pattern": ".*"
      },
      "blocking": true,
      "timeout_ms": 60000
    }
  },
  "runtime_lifecycle": {
    "idle_timeout_ms": 4920000,
    "operation": {
      "mcp_server": "webdev-mcp",
      "tool": "webdev._execute_operation"
    },
    "reconcile": {
      "mcp_server": "webdev-mcp",
      "tool": "webdev._reconcile_runtime"
    },
    "restores_project_dir": true,
    "run_start": {
      "mcp_server": "webdev-mcp",
      "tool": "webdev._run_start"
    },
    "context_compaction": {
      "mcp_server": "webdev-mcp",
      "tool": "webdev._context_compaction"
    },
    "context_snip": {
      "mcp_server": "webdev-mcp",
      "tool": "webdev._context_snip"
    }
  },
  "context_prerequisites": [
    {
      "tool": "webdev.config",
      "when": {
        "param": "method",
        "not_equals": "GET"
      },
      "rules": [
        {
          "path_prefix": "game/blueprint",
          "skill": "webdev",
          "page": "references/game-setup.md",
          "sha256": "fb2ac8cd7c0f9e77af259fa4f168e2fc07cf2183323261a5e2a1533ca804be12"
        },
        {
          "path_prefix": "game/blueprint/concepts",
          "skill": "webdev",
          "page": "references/game-blueprint-godot.md",
          "sha256": "b68b708e0dfe0651648f69049facdaad30ce6791f5115be5244ee08f5a2b125c"
        },
        {
          "path_prefix": "game/blueprint/update",
          "skill": "webdev",
          "page": "references/game-blueprint-update.md",
          "sha256": "ecb5947fbe2aa3352a1707b384c4a3a1af109d9e14b85c7612764f0eb42aae6a"
        },
        {
          "path_prefix": "game/multiplayer",
          "skill": "webdev",
          "page": "references/game-multiplayer.md",
          "sha256": "37d38fb0ae2d6bae0b3ae0b46798edf646ae001184d8c75bec9607f61ee6b95a"
        },
        {
          "path_prefix": "game/sharing",
          "skill": "webdev",
          "page": "references/game-sharing.md",
          "sha256": "58a051992a851fc6a34a0f8f25f52c2ada02a7f278c39dd31294a01a8d43301a"
        },
        {
          "path_prefix": "config/resources",
          "skill": "webdev",
          "page": "references/hosting.md",
          "sha256": "5d217de9b4cd635e397f53b860b22b369b00d03a202a0366d80fdfe6ee448b93"
        },
        {
          "path_prefix": "config/hosting",
          "skill": "webdev",
          "page": "references/hosting.md",
          "sha256": "5d217de9b4cd635e397f53b860b22b369b00d03a202a0366d80fdfe6ee448b93"
        },
        {
          "path_prefix": "config/analytics",
          "skill": "webdev",
          "page": "references/site-settings.md",
          "sha256": "ef7e41542fbdc50c9969446e1201a3e35900101bad08779a5e2a0633da3f33f1"
        },
        {
          "path_prefix": "config/branding",
          "skill": "webdev",
          "page": "references/site-settings.md",
          "sha256": "ef7e41542fbdc50c9969446e1201a3e35900101bad08779a5e2a0633da3f33f1"
        },
        {
          "path_prefix": "config/pwa",
          "skill": "webdev",
          "page": "references/pwa.md",
          "sha256": "32d57b74eb5f4294cf29b7cdb0646f49720bee10687624cda8f2803c3f9e4fff"
        },
        {
          "path_prefix": "config/git",
          "skill": "webdev",
          "page": "references/git-canonical.md",
          "sha256": "04ab7006352cd21dd0df117169f82de63f6273e8881ca3bb3cb4557827d302be"
        },
        {
          "path_prefix": "config/preview",
          "skill": "webdev",
          "page": "references/runtime.md",
          "sha256": "474c641d18f6cc61479307e2c860c80a0d68765051de0c2ffb523a182e9e05e1"
        },
        {
          "path_prefix": "publish",
          "skill": "webdev",
          "page": "references/git-checkpoints.md",
          "sha256": "e7ca5ed16f047bb7b38363ed7c378d0605cdd965396b266ff7d5cebb9196c2a6"
        },
        {
          "path_prefix": "config/visibility",
          "skill": "webdev",
          "page": "references/git-checkpoints.md",
          "sha256": "e7ca5ed16f047bb7b38363ed7c378d0605cdd965396b266ff7d5cebb9196c2a6"
        },
        {
          "path_prefix": "secrets",
          "skill": "webdev",
          "page": "references/secrets.md",

        }
      ]
    }
  ],
  "extensions": {
    "interaction-endpoint": {
      "schema": "manus.addon.interaction_endpoint/v1",
      "path": "/api/v1/interactions/respond"
    },
    "legacy-resource-migration": {
      "schema": "manus.addon.legacy_resource_migration/v2",
      "source_content_kinds": [
        "webdev_project"
      ]
    },
    "local-init-consent": {
      "schema": "manus.addon.notification/v1",
      "tag": "local_init_consent_settled",
      "text": "The owner responded to the local project code-storage card. Resume webdev.init_project with the returned requestId as initRequestId and the original arguments and project_dir unchanged. The Addon server checks the persisted decision; this notification is not authorization. If denied or expired, stop initialization.",
      "behavior": "wake",
      "presentation": "reminder",
      "payload": "json"
    },
    "visibility-confirmation-completed": {
      "schema": "manus.addon.notification/v1",
      "tag": "visibility_confirmation_completed",
      "text": "The user's website visibility decision is complete. Read webdev.config GET config/visibility for the current access scope. The payload reports succeeded, cancelled, failed, or unknown; do not treat cancellation or an uncertain result as approval or repeat the change automatically.",
      "behavior": "wake",
      "presentation": "reminder",
      "payload": "json"
    },
    "publish-confirmation-submitted": {
      "schema": "manus.addon.notification/v1",
      "tag": "publish_confirmation_submitted",
      "text": "The user settled the model-initiated publish confirmation and the server already submitted the pinned publication request. Call webdev.config with GET publish/requests/{operationId} once to read the result and start its background job. The job automatically returns the final publication result. Do not poll or repeat POST publish, and do not treat this notification payload as authorization.",
      "behavior": "wake",
      "presentation": "reminder",
      "payload": "json"
    },
    "publish-confirmation-denied": {
      "schema": "manus.addon.notification/v1",
      "tag": "publish_confirmation_denied",
      "text": "The user denied this model-initiated publish request. First call webdev.config with GET publish/requests/{operationId} only if the persisted result is needed. Do not repeat POST publish or reopen the card automatically; denial does not change the project auto-publish setting.",
      "behavior": "wake",
      "presentation": "reminder",
      "payload": "json"
    },
    "publish-confirmation-failed": {
      "schema": "manus.addon.notification/v1",
      "tag": "publish_confirmation_failed",
      "text": "This model-initiated publish confirmation reached a failed or stale result. First call webdev.config with GET publish/requests/{operationId} to read the authoritative persisted state. Do not repeat POST publish automatically, including when submission status is unknown; use current deployment facts and the user's direction before any new request. This notification payload is not authorization.",
      "behavior": "wake",
      "presentation": "reminder",
      "payload": "json"
    },
    "secret-input-filled": {
      "schema": "manus.addon.notification/v1",
      "tag": "secret_input_filled",
      "text": "The user completed the requested input card and the values are already applied on the platform — no settlement call is needed. Continue the task. If a command needs the new environment values in this sandbox right away, call webdev.config with GET config once to synchronize them. Never repeat a request that used replace_existing=true; that would open another replacement card.",
      "behavior": "interrupt",
      "presentation": "reminder"
    },
    "secret-input-cancelled": {
      "schema": "manus.addon.notification/v1",
      "tag": "secret_input_cancelled",
      "text": "The user cancelled the requested input card. The cancellation is already settled on the platform: do NOT repeat webdev.request_secrets or re-open the card unless the user asks for it. Read the current state with the webdev.config tool (GET config) if needed, then follow the user's direction.",
      "behavior": "wake",
      "presentation": "reminder"
    },
    "git-transfer-ready": {
      "schema": "manus.addon.notification/v1",
      "tag": "git_transfer_ready",
      "text": "The user saved the Git confirmation card and its inactive destination is ready. Continue the transfer now without asking the user to fill the card, confirm again, or send a follow-up message. The project is STILL using its original repository; this is not a completed connection or disconnection. Read references/git-canonical.md, then call webdev.config with GET config/git/transfer to get the current operation and prepare the workspace remote. Transfer code using the authorized temporary remote, then call POST config/git/complete for server verification. For GitHub to Manus, restore only the latest accepted checkpoint snapshot onto the expected Manus parent, not the GitHub history. If blocked, explain the blocker. If the user asks to cancel, call POST config/git/abort; never delete the destination repository or report completion before verification succeeds.",
      "behavior": "wake",
      "presentation": "reminder"
    },
    "git-transfer-cancelled": {
      "schema": "manus.addon.notification/v1",
      "tag": "git_transfer_cancelled",
      "text": "The user declined the Git repository transition confirmation. Do not reopen it or transfer code unless the user asks. The original repository remains in use. If needed, read the authoritative status with webdev.config GET config/git/transfer before reporting the outcome; do not delete the destination repository.",
      "behavior": "wake",
      "presentation": "reminder"
    },
    "game-blueprint-updated": {
      "schema": "manus.addon.notification/v1",
      "tag": "game_blueprint_updated",
      "text": "Game Blueprint decisions were saved. For an attached project, use webdev.config GET game/blueprint to read canonical saved decisions, then follow its nextAction and phase in the stored conversation language. Use POST game/blueprint/refresh with expectedRevision when coverage needs refresh, and POST game/blueprint/concepts for authorized concepts. Attached choices and selected concept metadata describe the saved response, but may be stale. This notification is a wake hint, not approval authority. For an attached project, if requiresProjectRecovery is true or choices are absent, use the same GET game/blueprint read; do not infer omitted constraints or initialize another project. Follow the installed continuation instructions if they differ from this hint. Preserve approved answers and narrower asset constraints. Generate concepts only with recorded mockup consent; never treat mockup consent as permission for generative production assets. When projectInitialized is true and approval is settled, continue the existing project without calling init_project again. An unbound legacy draft follows its installed compatible workflow; do not use project-bound recovery before initialization. A legacy pre-init draft still requires its approved reference before initialization. Do not repeat setup questions or generate a regular WebDev Blueprint for this game.",
      "behavior": "wake",
      "presentation": "reminder",
      "payload": "json"
    },
    "game-blueprint-cancelled": {
      "schema": "manus.addon.notification/v1",
      "tag": "game_blueprint_cancelled",
      "text": "The user cancelled the Game Blueprint. Read the canonical state through webdev.config GET game/blueprint. Preserve the existing scaffold; do not implement or source assets under the cancelled plan. Wait for new explicit direction.",
      "behavior": "wake",
      "presentation": "reminder",
      "payload": "json"
    },
    "firepower-blueprint-ready": {
      "schema": "manus.addon.notification/v1",
      "tag": "firepower_blueprint_ready",
      "text": "The Blueprint choices are saved and the model recommendation card is available. Preserve the saved Blueprint choices. A new user message can continue work in the current model; do not ask another model-selection question.",
      "behavior": "remind",
      "presentation": "reminder",
      "payload": "json"
    },
    "firepower-selected": {
      "schema": "manus.addon.notification/v1",
      "tag": "firepower_selected",
      "text": "The model-choice card is complete. Continue the initialized project using the saved Blueprint and planning guidance. For a Game project, read webdev.config GET game/blueprint and follow its current nextAction and saved choices. Do not ask for another model selection or initialize again.",
      "behavior": "remind",
      "presentation": "reminder"
    },
    "firepower-continue": {
      "schema": "manus.addon.notification/v1",
      "tag": "firepower_continue",
      "text": "The model-choice card is complete. Continue the initialized project using the saved Blueprint and planning guidance. For a Game project, read webdev.config GET game/blueprint and follow its current nextAction and saved choices. Do not ask for another model selection or initialize again.",
      "behavior": "wake",
      "presentation": "reminder"
    },
    "blueprint-confirmed": {
      "schema": "manus.addon.notification/v1",
      "tag": "blueprint_confirmed",
      "text": "The user confirmed the project blueprint. This Blueprint serves as the approved plan; skip writing another plan and requesting plan approval, then proceed to ToDo. Use the attached feature and power-up choices and any selected style. Keep the confirmed design direction; continue implementation without a separate design document.",
      "behavior": "wake",
      "presentation": "reminder",
      "payload": "json"
    },
    "blueprint-cancelled": {
      "schema": "manus.addon.notification/v1",
      "tag": "blueprint_cancelled",
      "text": "The project Blueprint card closed without a submitted answer when this run started, usually because the user sent a new message instead. The attached payload, when present, is that Blueprint exactly as presented: brief, features, design styles (listed in the order the user saw them) and power-ups. No choice from the card was submitted: selected flags are only the presented defaults, and any changes the user made in the card were not saved and are not reflected here. It is neither an approved nor a rejected plan. Read the user's latest message with this Blueprint as context and follow that message; when it refers to choices made in the card, trust its description over these defaults. Where the message leaves scope open, plan normally from the original request. Do not reopen the Blueprint card or ask the user to confirm it.",
      "behavior": "remind",
      "presentation": "reminder",
      "payload": "json"
    },
    "shopify-configured": {
      "schema": "manus.addon.notification/v1",
      "tag": "shopify_configured",
      "text": "The user selected and configured the Shopify store. Read references/shopify.md before continuing. For an unclaimed development store, use webdev.shopify. For an existing Connector store or a claimed store, use the Shopify Connector MCP tools. Before calling those tools, use manus-config config load to inspect the Shopify accounts and manus-config config save to set activeAccountUid to the selected account. For mode=connect, match the payload connectorUid and accountUid against the loaded configuration; the notification itself does not switch accounts or grant authorization. If the selected account cannot be authorized and activated through the normal Connector flow, stop and ask the owner; do not use the previous or default account.",
      "behavior": "wake",
      "presentation": "reminder",
      "payload": "json"
    },
    "shopify-setup-cancelled": {
      "schema": "manus.addon.notification/v1",
      "tag": "shopify_setup_cancelled",
      "text": "The user chose not to reconnect Shopify. Do not reopen Shopify setup unless the user asks. Continue without Shopify, or explain why the task cannot proceed if Shopify is essential.",
      "behavior": "wake",
      "presentation": "reminder"
    },
    "shopify-reauthorization-requested": {
      "schema": "manus.addon.notification/v1",
      "tag": "shopify_reauthorization_requested",
      "text": "The user asked to reconnect the Shopify store named in the payload (connectorUid, accountUid, and accountName when known). Their app cannot reconnect inside the setup card, so that card is closed and nothing was configured. Read references/shopify.md before continuing. Use manus-config config load, then manus-config config save to set the Shopify activeAccountUid to the payload accountUid. Then call the mcp tool with primitive auth, action login and server shopify so the user gets the Shopify reconnect card in chat; ask the user to finish it, then stop and wait. After the store is reconnected, call webdev.config POST integrations/shopify/enable with mode connect again so the user can choose the store in a new setup card. If no reconnect card was shown, or the new setup card asks to reconnect the same store again, do not repeat this loop; ask the user to reconnect the store in Manus Connectors and reply when done. This notification does not grant authorization. Do not use another account, create a development store, or configure Shopify yourself unless the user asks.",
      "behavior": "wake",
      "presentation": "reminder",
      "payload": "json"
    },
    "integration-disconnected": {
      "schema": "manus.addon.notification/v1",
      "tag": "integration_disconnected",
      "text": "The owner confirmed the disconnect and it is already applied: the payload provider and its managed secret declarations are removed, so new Preview runtimes no longer receive those values. Do not call disconnect again. Read the Disconnect section of references/payments.md (Stripe) or references/shopify.md (Shopify). Then remove that provider's code, routes, webhook handlers and environment usage from the project in this task, restart Preview, validate and save a checkpoint. The published site keeps its current version until the next publish.",
      "behavior": "wake",
      "presentation": "reminder",
      "payload": "json"
    },
    "integration-disconnect-cancelled": {
      "schema": "manus.addon.notification/v1",
      "tag": "integration_disconnect_cancelled",
      "text": "The owner cancelled the disconnect. Nothing changed; do not reopen the confirmation unless the user asks. Continue with the user's direction.",
      "behavior": "wake",
      "presentation": "reminder"
    },
    "hosting-mode-confirmed": {
      "schema": "manus.addon.notification/v1",
      "tag": "hosting_mode_confirmed",
      "text": "The user confirmed Reserved hosting and the requested configuration operation is already applied. Do not repeat the original PUT or imply that deployment has completed. Read the current state with webdev.config GET config, then GET infra/overview to report the declared mode and observed deployment reality. The bounded payload can say whether the result was unchanged, a rollout started, or it will apply on the next publish.",
      "behavior": "wake",
      "presentation": "reminder",
      "payload": "json"
    },
    "hosting-mode-cancelled": {
      "schema": "manus.addon.notification/v1",
      "tag": "hosting_mode_cancelled",
      "text": "The user cancelled the Reserved hosting confirmation. The cancellation is already settled; do not reopen the confirmation or repeat the original request unless the user asks. Read the current configuration only if needed, then continue with the user's direction.",
      "behavior": "wake",
      "presentation": "reminder"
    },
    "hosting-mode-failed": {
      "schema": "manus.addon.notification/v1",
      "tag": "hosting_mode_failed",
      "text": "The Reserved hosting confirmation reached a failed terminal result. Read the current state with webdev.config GET config and GET infra/overview before reporting the outcome. Do not blindly replay the original request or reopen the confirmation; use the bounded payload and current state to identify the actual recovery action.",
      "behavior": "wake",
      "presentation": "reminder",
      "payload": "json"
    }
  },

{
  "schema_version": "0.1",
  "kind": "manus_addon_package",
  "distribution": "managed",
  "update_mode": "hot",
  "host_permissions": ["manus_api.access", "manus_api.tasks", "manus_api.projects"],
  "addon": {
    "id": "manus-tasks",
    "version": "0.0.27",
    "owner": "manus",
    "display_name": "Manus Tasks",
    "description": "Manage Manus tasks, Sections, Projects, and temporary API access.",
    "backend_mode": "none"
  },
  "mcp_servers": {
    "manus-tasks": {
      "execution_mode": "runtime_mcp",
      "execution_modes": ["runtime_mcp", "device_mcp"],
      "transport": "stdio",
      "description": "Manage Manus tasks: create, find, rename, hide, share, archive, pin or favorite them; move them into, between or out of Projects or Sections; read their history and send them messages with file attachments. Also manage Sections, Projects and temporary API access. Parent agent only.",
      "command": "node",
      "args": ["runtime/server.mjs"],
      "model_visible_tools": [
        "get_access",
        "create_task",
        "update_task",
        "list_tasks",
        "list_sections",
        "create_section",
        "update_section",
        "send_task_message",
        "list_task_messages",
        "upload_file",
        "create_project",
        "update_project",
        "list_projects"
      ],
      "tool_host_permissions": {
        "get_access": ["manus_api.access"]
      }
    }
  },
  "device_artifacts": [
    {
      "target": { "os": "darwin", "arch": "arm64" },
      "path": "device/darwin-arm64.tar.gz"
    },
    {
      "target": { "os": "darwin", "arch": "amd64" },
      "path": "device/darwin-amd64.tar.gz"
    },
    {
      "target": { "os": "windows", "arch": "arm64" },
      "path": "device/windows-arm64.tar.gz"
    },
    {
      "target": { "os": "windows", "arch": "amd64" },
      "path": "device/windows-amd64.tar.gz"
    },
    {
      "target": { "os": "linux", "arch": "arm64", "libc": "gnu" },
      "path": "device/linux-arm64-gnu.tar.gz"
    },
    {
      "target": { "os": "linux", "arch": "amd64", "libc": "gnu" },
      "path": "device/linux-amd64-gnu.tar.gz"
    }
  ],
  "skills": {
    "manus-tasks": {
      "name": "manus-tasks",
      "mcp_server": "manus-tasks",
      "path": "skills/manus-tasks"
    }
  }
}
